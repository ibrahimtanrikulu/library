    "@angular/platform-browser-dynamic": "19.2.14",
    "@angular/router": "19.2.14",
    "@fortawesome/fontawesome-free": "^6.2.1",
    "rxjs": "^7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "^0.15.1"
  },
